{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Local Copilot",
            "type": "shell",
            "command": "~/go/bin/ollama-copilot",
            "args": ["-model", "codellama:code"],
            "isBackground": true,
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Start Copilot Proxy",
            "type": "shell", 
            "command": "node",
            "args": ["/tmp/copilot-proxy.js"],
            "isBackground": true,
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always", 
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Stop Local Copilot",
            "type": "shell",
            "command": "pkill",
            "args": ["-f", "ollama-copilot"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always"
            }
        },
        {
            "label": "Stop Copilot Proxy", 
            "type": "shell",
            "command": "pkill",
            "args": ["-f", "copilot-proxy.js"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always"
            }
        }
    ]
}